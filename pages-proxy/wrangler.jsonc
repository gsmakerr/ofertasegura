{
  // Endereço público ofertasegura.pages.dev: só repassa tudo para o Worker "ofertasegura".
  // Publica uma vez só, desta pasta: npx wrangler pages deploy --branch main
  "name": "ofertasegura",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-11-20",
  "services": [{ "binding": "SITE", "service": "ofertasegura" }]
}
