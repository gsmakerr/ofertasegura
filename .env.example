# ============================================================
#  OFERTA SEGURA — suas IDs de afiliado
#  1. Copie este arquivo com o nome  .env.local
#  2. Preencha o que você já tem (o que ficar vazio é ignorado:
#     o link sai limpo, sem comissão, e nada quebra)
#  3. Reinicie o servidor
#  Na hospedagem (Vercel, Netlify...), cadastre os MESMOS nomes
#  em "Environment variables" no painel do site.
# ============================================================

# AMAZON — Associados Amazon > canto superior direito mostra seu "ID de rastreamento"
# Exemplo: gsachados-20
AMAZON_ASSOCIATE_TAG=

# SHOPEE — affiliate.shopee.com.br > menu "Open API" > copie App ID e Secret
# Enquanto a Open API não for liberada, basta o seu ID de afiliado (só números):
SHOPEE_AFFILIATE_ID=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# MERCADO LIVRE — abra um link de afiliado seu já gerado e copie os dois
# valores que aparecem nele: ...&matt_tool=12345678&matt_word=seunome
MERCADOLIVRE_MATT_TOOL=
MERCADOLIVRE_MATT_WORD=

# FOTOS DOS PRODUTOS (opcional) — as lojas bloqueiam a leitura das páginas pelo servidor,
# então a foto vem pelas APIs oficiais:
# Amazon: associados.amazon.com.br/creatorsapi > seu aplicativo > ID e Secret da credencial
# (a Amazon só libera depois de 10 vendas qualificadas nos últimos 30 dias)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Mercado Livre: developers.mercadolivre.com.br > Minhas aplicações > Client ID e Client Secret
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

# MAGALU — nome da sua loja no Parceiro Magalu.
# Se sua loja é magazinevoce.com.br/magazinegsachados, coloque: gsachados
MAGALU_PARTNER_ID=

# ------------------------------------------------------------
# OPCIONAL — histórico permanente em hospedagem serverless
# (Vercel/Netlify apagam arquivos locais). Crie um banco Redis
# gratuito em upstash.com e cole os dois valores "REST" aqui.
# No seu PC não precisa: o histórico fica em data/verified-offers.json
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Endereço público do site (usado nos links de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
